# Copy this file to .env and fill in your values. Never commit .env to git.

# HuggingFace token — required for gated models (e.g. Llama 3).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Ollama server (default is fine if running locally)
OLLAMA_HOST=http://localhost:11434

# Set to 1 to enable verbose debug logging
DEBUG=0
